generator client { provider = "prisma-client-js" }

datasource db { provider = "postgresql" url = env("DATABASE_URL") }

enum LeadTemperature { HOT WARM COLD }
enum PipelineStage { NEW_LEAD CONTACTED REPLIED QUALIFIED CLOSED LOST }
enum CampaignChannel { EMAIL LINKEDIN WHATSAPP CALL }

enum ReplyIntent { INTERESTED OBJECTION NOT_NOW UNSUBSCRIBE }

model User {
  id String @id @default(cuid())
  name String?
  email String? @unique
  image String?
  createdAt DateTime @default(now())
  workspaces WorkspaceMember[]
}

model Workspace {
  id String @id @default(cuid())
  name String
  whiteLabelBrand String?
  createdAt DateTime @default(now())
  members WorkspaceMember[]
  leads Lead[]
  campaigns Campaign[]
}

model WorkspaceMember {
  id String @id @default(cuid())
  userId String
  workspaceId String
  role String @default("owner")
  user User @relation(fields:[userId], references:[id])
  workspace Workspace @relation(fields:[workspaceId], references:[id])
  @@unique([userId, workspaceId])
}

model Lead {
  id String @id @default(cuid())
  workspaceId String
  name String
  niche String
  city String
  website String?
  email String?
  phone String?
  rating Float?
  source String
  intentScore Int @default(0)
  temperature LeadTemperature @default(COLD)
  stage PipelineStage @default(NEW_LEAD)
  buyingSignals Json?
  audit Json?
  revenueModel Json?
  createdAt DateTime @default(now())
  workspace Workspace @relation(fields:[workspaceId], references:[id])
  messages OutreachMessage[]
}

model Campaign {
  id String @id @default(cuid())
  workspaceId String
  name String
  status String @default("draft")
  config Json
  createdAt DateTime @default(now())
  workspace Workspace @relation(fields:[workspaceId], references:[id])
}

model OutreachMessage {
  id String @id @default(cuid())
  leadId String
  channel CampaignChannel
  content String
  sentAt DateTime?
  replyText String?
  replyIntent ReplyIntent?
  lead Lead @relation(fields:[leadId], references:[id])
}
